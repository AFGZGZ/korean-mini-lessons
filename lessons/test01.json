{
  "id": "test01",
  "name": "Korean Basics 1",
  "version": 7,
  "lessons": [
    {
      "id": "gra3",
      "meta": ["4 min"],
      "level": "Beginner",
      "icon": "book-open",
      "title": "~이에요 / ~예요",
      "description": "How to say \"to be\" in Korean.",
      "explanation": [
        "Use <b><hl>~이에요 / ~예요</hl></b> to mean \"is / am / are.\"",
        "<br><br>Use <b>~이에요</b> after a consonant and <b>~예요</b> after a vowel."
      ],
      "takeaway": "Basic sentence ending for nouns.",
      "examples": [
        {
          "kr": "저는 학생이에요.",
          "translated": "I am a student."
        },
        {
          "kr": "이것은 물이에요.",
          "translated": "This is water."
        }
      ],
      "practice": [
        {
          "id": "gra3_pr1",
          "type": "fill",
          "prompt": "I am a teacher",
          "answer": "저는 선생님이에요"
        },
        {
          "id": "gra3_pr2",
          "type": "fill",
          "prompt": "This is a book",
          "answer": "이것은 책이에요"
        }
      ]
    },
    {
      "id": "gra4",
      "meta": ["4 min"],
      "level": "Beginner",
      "icon": "message-circle",
      "title": "~아요 / ~어요",
      "description": "How to speak in the present tense.",
      "explanation": [
        "Use <b><hl>~아요 / ~어요</hl></b> for polite present tense verbs.",
        "<br><br>Use <b>~아요</b> if the last vowel is ㅏ or ㅗ, otherwise use <b>~어요</b>."
      ],
      "takeaway": "Most common verb ending in Korean.",
      "examples": [
        {
          "kr": "밥을 먹어요.",
          "translated": "I eat rice."
        },
        {
          "kr": "물을 마셔요.",
          "translated": "I drink water."
        }
      ],
      "practice": [
        {
          "id": "gra4_pr1",
          "type": "fill",
          "prompt": "I read a book",
          "answer": "책을 읽어요"
        },
        {
          "id": "gra4_pr2",
          "type": "fill",
          "prompt": "I watch TV",
          "answer": "TV를 봐요"
        }
      ]
    },
    {
      "id": "gra11",
      "meta": ["4 min"],
      "level": "Beginner",
      "icon": "map-pin",
      "title": "~에서",
      "description": "How to say where an action happens.",
      "explanation": [
        "Use <b><hl>~에서</hl></b> to mark the place where an action occurs."
      ],
      "takeaway": "Used with action verbs to show location.",
      "examples": [
        {
          "kr": "학교에서 공부해요.",
          "translated": "I study at school."
        },
        {
          "kr": "집에서 쉬어요.",
          "translated": "I rest at home."
        }
      ],
      "practice": [
        {
          "id": "gra11_pr1",
          "type": "fill",
          "prompt": "I eat at home",
          "answer": "집에서 먹어요"
        },
        {
          "id": "gra11_pr2",
          "type": "fill",
          "prompt": "I work at a cafe",
          "answer": "카페에서 일해요"
        }
      ]
    },
    {
