  "lessons": [
    {
      "id": "gra13",
      "meta": ["4 min"],
      "level": "Beginner",
      "icon": "heart",
      "title": "~고 싶어요",
      "description": "How to express what you want to do.",
      "explanation": [
        "Use <b><hl>~고 싶어요</hl></b> to say \"want to do something.\""
      ],
      "takeaway": "Express desires.",
      "examples": [
        {
          "kr": "한국어를 배우고 싶어요.",
          "translated": "I want to learn Korean."
        },
        {
          "kr": "밥을 먹고 싶어요.",
          "translated": "I want to eat."
        }
      ],
      "practice": [
        {
          "id": "gra13_pr1",
          "type": "fill",
          "prompt": "I want to go",
          "answer": "가고 싶어요"
        },
        {
          "id": "gra13_pr2",
          "type": "fill",
          "prompt": "I want to study",
          "answer": "공부하고 싶어요"
        }
      ]
    },
    {
      "id": "gra14",
      "meta": ["4 min"],
      "level": "Beginner",
      "icon": "clock",
      "title": "~(으)ㄹ 거예요",
      "description": "How to talk about the future.",
      "explanation": [
        "Use <b><hl>~(으)ㄹ 거예요</hl></b> to express future plans."
      ],
      "takeaway": "Future tense expression.",
      "examples": [
        {
          "kr": "내일 공부할 거예요.",
          "translated": "I will study tomorrow."
        },
        {
          "kr": "영화를 볼 거예요.",
          "translated": "I will watch a movie."
        }
      ],
      "practice": [
        {
          "id": "gra14_pr1",
          "type": "fill",
          "prompt": "I will go",
          "answer": "갈 거예요"
        },
        {
          "id": "gra14_pr2",
          "type": "fill",
          "prompt": "I will eat",
          "answer": "먹을 거예요"
        }
      ]
    },
    {
      "id": "gra15",
      "meta": ["4 min"],
      "level": "Beginner",
      "icon": "x-circle",
      "title": "~지 않아요",
      "description": "A more formal way to negate sentences.",
      "explanation": ["Use <b><hl>~지 않아요</hl></b> to say \"do not.\""],
      "takeaway": "Formal negation form.",
      "examples": [
        {
          "kr": "밥을 먹지 않아요.",
          "translated": "I do not eat."
        },
        {
          "kr": "학교에 가지 않아요.",
          "translated": "I do not go to school."
        }
      ],
      "practice": [
        {
          "id": "gra15_pr1",
          "type": "fill",
          "prompt": "I do not study",
          "answer": "공부하지 않아요"
        },
        {
          "id": "gra15_pr2",
          "type": "fill",
          "prompt": "I do not go",
          "answer": "가지 않아요"
        }
      ]
    },
    {
      "id": "gra16",
      "meta": ["3 min"],
      "level": "Beginner",
      "icon": "plus",
      "title": "~도",
      "description": "How to say \"also\" or \"too.\"",
      "explanation": ["Use <b><hl>~도</hl></b> to mean \"also.\""],
      "takeaway": "Adds inclusion.",
      "examples": [
        {
          "kr": "저도 가요.",
          "translated": "I also go."
        },
        {
          "kr": "물도 마셔요.",
          "translated": "I also drink water."
        }
      ],
      "practice": [
        {
          "id": "gra16_pr1",
          "type": "fill",
          "prompt": "I also eat",
          "answer": "저도 먹어요"
        },
        {
          "id": "gra16_pr2",
          "type": "fill",
          "prompt": "I also study",
          "answer": "저도 공부해요"
        }
      ]
    },
    {
      "id": "gra17",
      "meta": ["3 min"],
      "level": "Beginner",
      "icon": "minus",
      "title": "~만",
      "description": "How to say \"only.\"",
      "explanation": ["Use <b><hl>~만</hl></b> to mean \"only.\""],
      "takeaway": "Limits meaning.",
      "examples": [
        {
          "kr": "물만 마셔요.",
          "translated": "I only drink water."
        },
        {
          "kr": "저만 가요.",
          "translated": "Only I go."
        }
      ],
      "practice": [
        {
          "id": "gra17_pr1",
          "type": "fill",
          "prompt": "I only eat",
          "answer": "저만 먹어요"
        },
        {
          "id": "gra17_pr2",
          "type": "fill",
          "prompt": "I only study",
          "answer": "저만 공부해요"
        }
      ]
    },
    {
      "id": "gra18",
      "meta": ["4 min"],
      "level": "Beginner",
      "icon": "arrow-right",
      "title": "~에서 ~까지",
      "description": "How to express ranges.",
      "explanation": ["Use <b><hl>~에서 ~까지</hl></b> to mean \"from ~ to.\""],
      "takeaway": "Express time/place range.",
      "examples": [
        {
          "kr": "집에서 학교까지 가요.",
          "translated": "I go from home to school."
        },
        {
          "kr": "아침에서 저녁까지 공부해요.",
          "translated": "I study from morning to evening."
        }
      ],
      "practice": [
        {
          "id": "gra18_pr1",
          "type": "fill",
          "prompt": "From home to the park",
          "answer": "집에서 공원까지"
        },
        {
          "id": "gra18_pr2",
          "type": "fill",
          "prompt": "From school to home",
          "answer": "학교에서 집까지"
        }
      ]
    },
    {
      "id": "gra19",
      "meta": ["5 min"],
      "level": "Beginner",
      "icon": "link",
      "title": "~아/어서",
      "description": "How to connect reasons.",
      "explanation": [
        "Use <b><hl>~아/어서</hl></b> to mean \"so\" or \"because.\""
      ],
      "takeaway": "Express reason or sequence.",
      "examples": [
        {
          "kr": "배가 고파서 먹어요.",
          "translated": "I eat because I am hungry."
        },
        {
          "kr": "비가 와서 집에 있어요.",
          "translated": "I stay home because it rains."
        }
      ],
      "practice": [
        {
          "id": "gra19_pr1",
          "type": "fill",
          "prompt": "I am tired so I sleep",
          "answer": "피곤해서 자요"
        },
        {
          "id": "gra19_pr2",
          "type": "fill",
          "prompt": "I am busy so I study",
          "answer": "바빠서 공부해요"
        }
      ]
    },
    {
      "id": "gra20",
      "meta": ["4 min"],
      "level": "Beginner",
      "icon": "shuffle",
      "title": "~지만",
      "description": "How to contrast ideas.",
      "explanation": ["Use <b><hl>~지만</hl></b> to mean \"but.\""],
      "takeaway": "Contrast two ideas.",
      "examples": [
        {
          "kr": "작지만 좋아요.",
          "translated": "It is small but good."
        },
        {
          "kr": "바쁘지만 가요.",
          "translated": "I am busy but I go."
        }
      ],
      "practice": [
        {
          "id": "gra20_pr1",
          "type": "fill",
          "prompt": "It is cheap but good",
          "answer": "싸지만 좋아요"
        },
        {
          "id": "gra20_pr2",
          "type": "fill",
          "prompt": "I am tired but study",
          "answer": "피곤하지만 공부해요"
        }
      ]
    },
